# Copy to .env and use a dedicated, empty PRPDN MySQL database.
# URL-encode special characters in the username/password.
DATABASE_URL="mysql://prpdn:CHANGE_ME@127.0.0.1:3306/prpdn"
# Separate migration account; runtime account only needs SELECT/INSERT/UPDATE/DELETE.
DIRECT_URL="mysql://prpdn_migrate:CHANGE_ME@127.0.0.1:3306/prpdn"
BETTER_AUTH_URL="http://127.0.0.1:3000"
BETTER_AUTH_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Backend limits, configurable for deployment (not a fixed product limitation).
IMPORT_MAX_BYTES="104857600"
IMPORT_MAX_ROWS="100000"
# Initial administrator is created explicitly by the bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME="Administrator PRPDN"
BOOTSTRAP_ADMIN_PASSWORD=""
